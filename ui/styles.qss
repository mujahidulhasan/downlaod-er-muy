QWidget { background: #0b0f14; color: #f5f7fa; font-family: "Segoe UI"; font-size: 13px; }
QFrame#Sidebar, QFrame#TopBar, QFrame#StatusBar, QFrame#Surface { background: #111820; border: 1px solid #293441; border-radius: 9px; }
QLabel#Brand { font-size: 16px; font-weight: 700; color: #f5f7fa; }
QLabel#PageTitle { font-size: 27px; font-weight: 700; }
QLabel#Muted, QLabel#StatLabel { color: #8b98a7; }
QLabel#StatValue { font-size: 20px; font-weight: 700; }
QLineEdit, QTextEdit, QComboBox, QListWidget { background: #1c2530; border: 1px solid #293441; border-radius: 7px; padding: 9px; color: #f5f7fa; selection-background-color: #3b82f6; }
QTextEdit { padding: 11px; }
QPushButton { background: #1c2530; border: 1px solid #293441; border-radius: 7px; padding: 9px 14px; color: #f5f7fa; }
QPushButton:hover { border-color: #3b82f6; background: #202d3b; }
QPushButton#Primary { background: #3b82f6; border-color: #3b82f6; font-weight: 700; }
QPushButton#Primary:hover { background: #2563eb; }
QPushButton#Nav { text-align: left; border: 0; background: transparent; color: #a8b3c0; padding: 10px 12px; }
QPushButton#Nav:hover, QPushButton#Nav[active="true"] { background: #1c2530; color: #f5f7fa; }
QProgressBar { background: #1c2530; border: 0; border-radius: 4px; height: 8px; text-align: center; }
QProgressBar::chunk { background: #3b82f6; border-radius: 4px; }
QScrollArea { border: 0; }
QCheckBox { spacing: 8px; }
QSplitter::handle { background: #293441; }
